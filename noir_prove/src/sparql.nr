use crate::types::Triple;

pub(crate) type BGP = [Triple; 3];
pub(crate) type Hidden = [Field; 14];
pub(crate) struct Variables {
  pub(crate) person: Field,
  pub(crate) age: Field,
}

pub(crate) fn checkBinding(bgp: BGP, variables: Variables, hidden: Hidden) {
  assert(variables.person == bgp[0].terms[0]);
  assert(variables.age == bgp[0].terms[2]);
  assert(std::hash::pedersen_hash([2, std::hash::pedersen_hash([hidden[0], hidden[1], 638735893058869413402024148085879111143364657497749380190880060567766766509, 1686263426824985399110139734075659485152727784697459471589262910047968709019])]) == variables.age);
  assert(std::hash::pedersen_hash([2, std::hash::pedersen_hash([hidden[2], hidden[3], 638735893058869413402024148085879111143364657497749380190880060567766766509, 1686263426824985399110139734075659485152727784697459471589262910047968709019])]) == variables.age);
  assert(std::hash::pedersen_hash([2, std::hash::pedersen_hash([hidden[6], hidden[7], 638735893058869413402024148085879111143364657497749380190880060567766766509, 1686263426824985399110139734075659485152727784697459471589262910047968709019])]) == variables.age);
  assert(std::hash::pedersen_hash([2, std::hash::pedersen_hash([hidden[8], hidden[9], 638735893058869413402024148085879111143364657497749380190880060567766766509, 1686263426824985399110139734075659485152727784697459471589262910047968709019])]) == variables.age);
  assert(std::hash::pedersen_hash([2, std::hash::pedersen_hash([hidden[10], hidden[11], 638735893058869413402024148085879111143364657497749380190880060567766766509, 1686263426824985399110139734075659485152727784697459471589262910047968709019])]) == variables.age);
  assert(std::hash::pedersen_hash([2, std::hash::pedersen_hash([hidden[12], hidden[13], 638735893058869413402024148085879111143364657497749380190880060567766766509, 1686263426824985399110139734075659485152727784697459471589262910047968709019])]) == variables.age);
  assert(((variables.person == bgp[1].terms[0]) & (10933861860104938182078829299080821517398489297748654949784063660458894029192 == bgp[0].terms[1]) & (17306104366712127004102468914826498934223414371773065298117212414330870349397 == bgp[1].terms[1]) & (bgp[1].terms[2] == bgp[2].terms[0]) & (8313629903513261037716482973670331048977275807188631398721013040184826894172 == bgp[2].terms[1]) & (30 >= (hidden[1] as i32)) & ((hidden[3] as i32) >= 18) & ((bgp[1].terms[2] == std::hash::pedersen_hash([1, hidden[4]])) == false) & ((bgp[2].terms[2] == std::hash::pedersen_hash([1, hidden[5]])) == false) & ((bgp[2].terms[2] == std::hash::pedersen_hash([0, hidden[5]])) == false) & ((bgp[2].terms[2] == 17840193226106193059892095401922447739391510205241150426256197471441196993075) == false) & ((bgp[2].terms[2] == 13860298789107918980429567998994960916296497789945762596860148026638009827801) == false) & (bgp[2].terms[2] == 4266899674637143358065652955755042057898113753838328213755066979966455448915)) | ((variables.person == bgp[1].terms[0]) & (10933861860104938182078829299080821517398489297748654949784063660458894029192 == bgp[0].terms[1]) & (17306104366712127004102468914826498934223414371773065298117212414330870349397 == bgp[1].terms[1]) & (bgp[1].terms[2] == bgp[2].terms[0]) & (8313629903513261037716482973670331048977275807188631398721013040184826894172 == bgp[2].terms[1]) & (30 >= (hidden[7] as i32)) & ((hidden[9] as i32) >= 18) & ((bgp[1].terms[2] == std::hash::pedersen_hash([1, hidden[4]])) == false) & ((bgp[2].terms[2] == std::hash::pedersen_hash([1, hidden[5]])) == false) & ((bgp[2].terms[2] == std::hash::pedersen_hash([0, hidden[5]])) == false) & ((bgp[2].terms[2] == 17840193226106193059892095401922447739391510205241150426256197471441196993075) == false) & ((bgp[2].terms[2] == 13860298789107918980429567998994960916296497789945762596860148026638009827801) == false) & (bgp[2].terms[2] == 10924133395370588815282325585774261326991880058888389831600565987478861978627)) | ((variable
{
  "name": "noir_sparql_proof",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build:tsc": "tsc",
    "build:noir:gen": "node ./dist/generateFunctional2.js",
    "build:noir:compile": "cd noir_prove && nargo compile",
    "build:noir:ir": "node scripts/build-noir-from-ir.mjs",
    "build:noir": "npm run build:noir:gen && npm run build:noir:compile",
    "build": "npm run build:tsc && npm run build:noir",
    "sign": "node ./sign.js",
    "prove": "node ./prove.js",
    "update-readme": "node ./update-readme-timing.js",
    "test:operators": "node ./tests/operators.test.mjs",
    "test:integration:operators": "node tests/integration/operators.integration.test.mjs",
    "test:ir": "node tests/ir/basic.ir.test.mjs",
    "test:pipeline": "node tests/pipeline/program.test.mjs",
    "test": "npm run build && npm run test:operators && npm run sign && npm run prove",
    "test:all": "npm run build:tsc && npm run test:operators && npm run test:integration:operators && npm run test:pipeline",
    "test:sparql11": "node tests/sparql11/harness.test.mjs"
  },
  "author": "",
  "license": "MIT",
  "description": "",
